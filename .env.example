# PostgreSQL (local: docker compose up -d)
DATABASE_URL="postgresql://pyaterochka:pyaterochka@localhost:5432/pyaterochka?schema=public"

# Production compose (docker compose -f docker-compose.prod.yml up -d)
# Postgres is not published to the host. Change the password.
POSTGRES_USER="pyaterochka"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="pyaterochka"

# Admin login (not stored in the database)
ADMIN_PASSWORD="changeme"

# API
PORT=3001
# Bind address. Docker/production should stay 0.0.0.0
HOST=0.0.0.0

# Telegram bot + Mini App
# Optional fallbacks. Prefer the admin UI → Telegram section.
# Token from @BotFather. Leave empty to configure in admin.
BOT_TOKEN=""
# Public HTTPS URL of the app (same origin as the Mini App).
# Telegram Mini Apps require https. Put Caddy/nginx or a tunnel in front.
# In @BotFather: Bot Settings → Menu Button → this same URL
MINIAPP_URL=""
