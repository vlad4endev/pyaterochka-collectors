{
  "name": "pyaterochka-collectors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "build": "prisma generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "prod:up": "docker compose -f docker-compose.prod.yml up --build -d",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "lint": "eslint server prisma/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@maxhub/max-bot-api": "^0.2.5",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "hono": "^4.13.2",
    "https-proxy-agent": "^9.1.0",
    "node-fetch": "^2.7.0",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socks-proxy-agent": "^10.1.0",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
